{"name":"capture_electron_scenario","description":"Use this for a provider-owned Electron run when passive CDP or Inspector observation cannot exercise application behavior. REA owns startup and teardown, accepts caller-defined click/wait actions plus window-targeted renderer reload/crash and synthetic open-url/second-instance delivery, and returns correlated window/WebContents/process/preload/session/navigation/shell/IPC evidence without retaining payload values. Results identify observed and unavailable event families, coverage status, action targets, and truncation. External shell, navigation, permission, download, popup, updater, and OS-integration effects are blocked and recorded. Use passive Electron tools for observation-only work.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"examples":[{"actions":[{"kind":"click","selector":"#run","step_id":"exercise-ipc"}],"application_path":"/Applications/Example.app/Contents/Resources/main.js","args":[],"executable_path":"/Applications/Electron.app/Contents/MacOS/Electron"}],"properties":{"actions":{"default":[],"description":"Value for actions.","items":{"oneOf":[{"additionalProperties":false,"properties":{"kind":{"const":"click","description":"Value for kind.","type":"string"},"selector":{"description":"Value for selector.","minLength":1,"type":"string"},"step_id":{"description":"Value for step id.","minLength":1,"type":"string"},"window_index":{"default":0,"description":"Value for window index.","maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["step_id","kind","selector"],"type":"object"},{"additionalProperties":false,"properties":{"duration_ms":{"description":"Value for duration ms.","maximum":9007199254740991,"minimum":0,"type":"integer"},"kind":{"const":"wait","description":"Value for kind.","type":"string"},"step_id":{"description":"Value for step id.","minLength":1,"type":"string"},"window_index":{"description":"Value for window index.","maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["step_id","kind","duration_ms"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"renderer-reload","description":"Value for kind.","type":"string"},"step_id":{"description":"Value for step id.","minLength":1,"type":"string"},"window_index":{"default":0,"description":"Value for window index.","maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["step_id","kind"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"renderer-crash","description":"Value for kind.","type":"string"},"step_id":{"description":"Value for step id.","minLength":1,"type":"string"},"window_index":{"default":0,"description":"Value for window index.","maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["step_id","kind"],"type":"object"},{"additionalProperties":false,"properties":{"delivery":{"description":"Value for delivery.","enum":["open-url","second-instance"],"type":"string"},"kind":{"const":"deep-link","description":"Value for kind.","type":"string"},"step_id":{"description":"Value for step id.","minLength":1,"type":"string"},"url":{"description":"Value for url.","minLength":1,"type":"string"}},"required":["step_id","kind","delivery","url"],"type":"object"}]},"type":"array"},"application_path":{"description":"Local filesystem path for application.","minLength":1,"type":"string"},"application_root":{"description":"Local filesystem application root selected for this operation.","minLength":1,"type":"string"},"args":{"default":[],"description":"Value for args.","items":{"type":"string"},"type":"array"},"executable_path":{"description":"Local filesystem path for executable.","minLength":1,"type":"string"}},"required":["executable_path","application_path"],"type":"object"}}